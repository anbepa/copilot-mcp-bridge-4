# =============================================================================
#  Configuración del MCP Unified Server — copia este archivo a .env
# =============================================================================

# --- Red -------------------------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8787
MCP_LOG_LEVEL=info

# --- Cloudflare Tunnel -----------------------------------------------------
# true  -> el script levanta el túnel automáticamente (Quick Tunnel efímero)
# false -> solo servidor local
ENABLE_TUNNEL=true
# Opcional: token de un túnel permanente creado en el dashboard de Cloudflare
# (Zero Trust > Networks > Tunnels). Si se define, se usa en vez del Quick Tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
# Hostname asociado a ese túnel permanente (solo informativo en consola)
CLOUDFLARED_HOSTNAME=

# --- Seguridad -------------------------------------------------------------
# Si se define, todas las peticiones deben enviar: Authorization: Bearer <token>
MCP_AUTH_TOKEN=

# Raíz permitida para las tools de filesystem (por defecto el cwd del proceso)
MCP_WORKSPACE_ROOT=

# true permite operar FUERA de la raíz anterior (¡úsalo con cuidado!)
MCP_ALLOW_OUTSIDE_ROOT=false

# Habilita/deshabilita el grupo completo de herramientas de terminal
MCP_ENABLE_TERMINAL=true

# Lista negra de comandos: patrones regex separados por coma. Ejemplo:
# MCP_COMMAND_DENYLIST=rm\s+-rf\s+/,mkfs,shutdown,:\(\)\{
MCP_COMMAND_DENYLIST=

# --- Navegador (Playwright) ------------------------------------------------
# Habilita/deshabilita el grupo completo de herramientas browser_*
MCP_ENABLE_BROWSER=true

# Instala Playwright + el binario del navegador al arrancar (start.sh/start.bat).
# Requiere red y descarga ~150 MB la primera vez.
ENABLE_BROWSER=false

# Motor: chromium | firefox | webkit
MCP_BROWSER_ENGINE=chromium
MCP_BROWSER_HEADLESS=true
MCP_BROWSER_WIDTH=1280
MCP_BROWSER_HEIGHT=720
MCP_BROWSER_TIMEOUT_MS=30000
# load | domcontentloaded | networkidle | commit
MCP_BROWSER_WAIT_UNTIL=domcontentloaded
MCP_BROWSER_USER_AGENT=
MCP_BROWSER_EXECUTABLE_PATH=
# Carpeta de capturas, trazas, vídeos y storage-state.
# Por defecto: <MCP_WORKSPACE_ROOT>/browser-output
MCP_BROWSER_OUTPUT_DIR=

# ⚠️  browser_run_code_unsafe ejecuta código Python arbitrario contra la sesión
#     del navegador (equivale a RCE). Actívalo SOLO en entornos de confianza.
MCP_ENABLE_UNSAFE_BROWSER_CODE=false

# --- API Testing & QA (Módulo C) -------------------------------------------
# Habilita/deshabilita el grupo completo de herramientas de API testing
MCP_ENABLE_API_TESTING=true

# Prefijo para URLs relativas. Con esto puedes llamar a build_and_send_request
# con url="/v1/clientes" en vez de la URL absoluta completa.
MCP_API_BASE_URL=

# Timeout (segundos) por petición HTTP
MCP_API_TIMEOUT=30

# Verificación de certificados TLS. Ponlo a false SOLO en QA con certificados
# autofirmados; nunca contra producción.
MCP_API_VERIFY_TLS=true

MCP_API_FOLLOW_REDIRECTS=true
MCP_API_MAX_REDIRECTS=10

# Lista blanca de hosts (regex separados por coma). Vacío = cualquier host.
# Ejemplo: MCP_API_HOST_ALLOWLIST=^api\.bancolombia\.com\.co$,\.qa\.interno$
MCP_API_HOST_ALLOWLIST=

# Máx. caracteres de cuerpo devueltos/almacenados por respuesta
MCP_API_MAX_BODY_CHARS=20000

# Nº máximo de peticiones conservadas en el historial de la sesión
MCP_API_MAX_HISTORY=500

# Timeout (s) para cada script pm.* de colección evaluado en Node
MCP_API_SCRIPT_TIMEOUT=30

# Timeout (s) total de una ejecución de colección Postman
MCP_API_COLLECTION_TIMEOUT=900

# Directorio base donde generate_test_report escribe los .md
# (relativo a MCP_WORKSPACE_ROOT). Vacío = raíz del workspace.
MCP_API_REPORT_DIR=

# --- Límites ---------------------------------------------------------------
MCP_COMMAND_TIMEOUT=120
MCP_MAX_OUTPUT_CHARS=200000
MCP_MAX_READ_BYTES=5000000
MCP_MAX_SEARCH_RESULTS=500
MCP_SSE_KEEPALIVE=15
