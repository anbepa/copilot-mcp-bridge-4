{
  "$comment": "Configuración por defecto. Copia a config/local.json para sobrescribir (no se versiona).",

  "sandbox": {
    "roots": ["./workspace"],
    "denyGlobs": [
      "**/.git/**", "**/node_modules/**", "**/.env", "**/.env.*",
      "**/*.pem", "**/*.key", "**/id_rsa*", "**/.ssh/**",
      "**/.aws/**", "**/.npmrc", "**/secrets/**"
    ]
  },

  "policy": {
    "autoApproveReads": true,
    "requireApprovalForWrites": true,
    "requireApprovalForExec": true,
    "allowExec": true,
    "allowedServers": ["unified"],
    "deniedTools": [],
    "maxWritesPerTask": 25
  },

  "budget": {
    "maxTurns": 12,
    "maxStepsPerPlan": 20,
    "maxBytesPerResult": 8000,
    "maxTotalResultBytes": 120000,
    "maxTaskSeconds": 900,
    "parallelism": 4,
    "maxRepairAttempts": 2
  },

  "context": {
    "maxTreeEntries": 400,
    "maxSymbolFiles": 120,
    "maxKeyFileBytes": 6000,
    "keyFiles": [
      "package.json", "tsconfig.json", "pyproject.toml", "requirements.txt",
      "go.mod", "pom.xml", "build.gradle", "Cargo.toml",
      "README.md", "Makefile", "docker-compose.yml"
    ],
    "codeExtensions": [
      ".js", ".mjs", ".cjs", ".jsx", ".ts", ".tsx", ".py", ".java",
      ".go", ".rs", ".rb", ".php", ".cs", ".kt", ".swift", ".sh", ".sql"
    ],
    "maxPackBytes": 60000
  },

  "driver": {
    "kind": "playwright",
    "url": "https://m365.cloud.microsoft/chat",
    "model": "GPT 5.6 Think",
    "selectModelEachTurn": false,
    "headless": false,
    "userDataDir": "~/.copilot-mcp-bridge/browser-profile",
    "cdpEndpoint": "http://127.0.0.1:9222",
    "timeoutMs": 120000,
    "editorTimeoutMs": 60000,
    "quietMs": 1500,
    "pollMs": 250,
    "preferClipboard": true,
    "attachments": {
      "enabled": true,
      "thresholdChars": 4000
    }
  },

  "mcp": {
    "servers": {
      "unified": {
        "description": "MCP Unified Server (82 tools: filesystem + terminal + browser + API testing) vía adaptador stdio.",
        "command": "python3",
        "args": ["./mcp-unified-server 3/stdio_server.py", "{{ROOTS}}"],
        "env": {
          "MCP_LOG_LEVEL": "info",
          "MCP_ENABLE_TERMINAL": "true",
          "MCP_ENABLE_BROWSER": "true",
          "MCP_BROWSER_HEADLESS": "true"
        },
        "enabled": true
      }
    }
  },

  "audit": {
    "dir": "./.audit",
    "enabled": true
  }
}
